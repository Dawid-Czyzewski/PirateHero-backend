<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                    https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Character\Domain\Model\Character" table="characters">
        <id name="id" type="character_id" column="id"/>

        <field name="userId" type="user_id" column="user_id" unique="true"/>

        <embedded name="level" class="App\Character\Domain\Model\Level" use-column-prefix="false"/>
        <embedded name="experience" class="App\Character\Domain\Model\Experience" use-column-prefix="false"/>
        <embedded name="stats" class="App\Character\Domain\Model\Stats" use-column-prefix="false"/>
        <embedded name="wallet" class="App\Character\Domain\Model\Wallet" use-column-prefix="false"/>
        <embedded name="appearance" class="App\Character\Domain\Model\Appearance" use-column-prefix="false"/>
    </entity>
</doctrine-mapping>
