<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Reset password</title>
</head>
<body>
    <p>Hello {{ username }},</p>
    <p>We received a request to reset your Fame Fighters password.</p>
    <p><a href="{{ frontendUrl }}/auth/reset-password/{{ resetToken }}">Reset password</a></p>
    <p>If you did not request this, you can ignore this email.</p>
    <p>This link expires in 1 hour.</p>
</body>
</html>
